                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum by (cluster, namespace, label_product, label_project) (\n  clamp_max(\n    topk(1,\n        kube_namespace_labels{label_product=~\"$product\", label_project=~\"$project\", label_environment_kind=~\"$kind\", cluster=~\"$cluster\", namespace=~\"$namespace\", label_product!=\"\"} * 2\n      or\n        kube_namespace_labels{label_product=~\"$product\", label_project=~\"$project\", label_environment_kind=~\"$kind\", cluster=~\"$cluster\", namespace=~\"$namespace\"}\n    ) by (cluster, namespace)\n    , 1)\n  * on (cluster, namespace) group_right(label_environment_kind, label_project, label_product, label_client)\n  finops:namespace_cpu_usage:max_7d{cluster=~\"$cluster\", namespace=~\"$namespace\"}\n)\n",
                        "instant": true,
                        "legendFormat": "",
                        "range": false,
                        "format": "table"
