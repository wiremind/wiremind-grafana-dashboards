{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "finops-capacity-node"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "spec": {
              "limit": 100,
              "matchAny": false,
              "tags": [],
              "type": "dashboard"
            },
            "labels": {
              "grafana.app/export-label": "grafana-1"
            }
          },
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Free CPU, memory and local volume space per node, so a placement that fails on one resource while another looks healthy is visible in one row.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Free capacity per node",
          "description": "Every schedulable node in the pool with all three resources side by side. Sort on any column to find the mismatch that blocks placement — a node with terabytes free and no CPU left cannot take anything. Nodes with no local storage show an empty volume column; they are still valid CPU and memory capacity.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "(\n  sum by (cluster, node) (kube_node_status_allocatable{resource=\"cpu\", cluster=~\"$cluster\"})\n  -\n  (\n    sum by (cluster, node) (kube_pod_container_resource_requests{resource=\"cpu\", node!=\"\", cluster=~\"$cluster\"})\n    or\n    sum by (cluster, node) (kube_node_status_allocatable{resource=\"cpu\", cluster=~\"$cluster\"}) * 0\n  )\n)\n  and on (cluster, node) (\n  (\n    group by (cluster, node) (kube_node_spec_unschedulable{cluster=~\"$cluster\"} == 0)\n    unless group by (cluster, node) (kube_node_role{role=\"control-plane\", cluster=~\"$cluster\"})\n  )\n  ${pool} (\n    (\n    group by (cluster, node) (kube_node_spec_unschedulable{cluster=~\"$cluster\"} == 0)\n    unless group by (cluster, node) (kube_node_role{role=\"control-plane\", cluster=~\"$cluster\"})\n  )\n    and group by (cluster, node) (\n      kube_node_labels{label_node_role_wiremind_io_production=\"true\", cluster=~\"$cluster\"}\n      or kube_node_labels{label_node_role_kubernetes_io_production=\"true\", cluster=~\"$cluster\"}\n    )\n  )\n)\n",
                        "instant": true,
                        "legendFormat": "",
                        "range": false,
                        "format": "table"
                      },
                      "labels": {
                        "grafana.app/export-label": "prometheus-1",
                        "grafana.app/export-datasource-name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "(\n  sum by (cluster, node) (kube_node_status_allocatable{resource=\"memory\", cluster=~\"$cluster\"})\n  -\n  (\n    sum by (cluster, node) (kube_pod_container_resource_requests{resource=\"memory\", node!=\"\", cluster=~\"$cluster\"})\n    or\n    sum by (cluster, node) (kube_node_status_allocatable{resource=\"memory\", cluster=~\"$cluster\"}) * 0\n  )\n)\n  and on (cluster, node) (\n  (\n    group by (cluster, node) (kube_node_spec_unschedulable{cluster=~\"$cluster\"} == 0)\n    unless group by (cluster, node) (kube_node_role{role=\"control-plane\", cluster=~\"$cluster\"})\n  )\n  ${pool} (\n    (\n    group by (cluster, node) (kube_node_spec_unschedulable{cluster=~\"$cluster\"} == 0)\n    unless group by (cluster, node) (kube_node_role{role=\"control-plane\", cluster=~\"$cluster\"})\n  )\n    and group by (cluster, node) (\n      kube_node_labels{label_node_role_wiremind_io_production=\"true\", cluster=~\"$cluster\"}\n      or kube_node_labels{label_node_role_kubernetes_io_production=\"true\", cluster=~\"$cluster\"}\n    )\n  )\n)\n",
                        "instant": true,
                        "legendFormat": "",
                        "range": false,
                        "format": "table"
                      },
                      "labels": {
                        "grafana.app/export-label": "prometheus-1",
                        "grafana.app/export-datasource-name": "${datasource}"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "sum by (cluster, node) (topolvm_volumegroup_available_bytes{cluster=~\"$cluster\"})\n  and on (cluster, node) (\n  (\n    group by (cluster, node) (kube_node_spec_unschedulable{cluster=~\"$cluster\"} == 0)\n    unless group by (cluster, node) (kube_node_role{role=\"control-plane\", cluster=~\"$cluster\"})\n  )\n  ${pool} (\n    (\n    group by (cluster, node) (kube_node_spec_unschedulable{cluster=~\"$cluster\"} == 0)\n    unless group by (cluster, node) (kube_node_role{role=\"control-plane\", cluster=~\"$cluster\"})\n  )\n    and group by (cluster, node) (\n      kube_node_labels{label_node_role_wiremind_io_production=\"true\", cluster=~\"$cluster\"}\n      or kube_node_labels{label_node_role_kubernetes_io_production=\"true\", cluster=~\"$cluster\"}\n    )\n  )\n)\n",
                        "instant": true,
                        "legendFormat": "",
                        "range": false,
                        "format": "table"
                      },
                      "labels": {
                        "grafana.app/export-label": "prometheus-1",
                        "grafana.app/export-datasource-name": "${datasource}"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "merge",
                  "spec": {
                    "options": {}
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true
                      },
                      "indexByName": {
                        "cluster": 0,
                        "node": 1,
                        "Value #A": 2,
                        "Value #B": 3,
                        "Value #C": 4
                      },
                      "renameByName": {
                        "cluster": "Cluster",
                        "node": "Node",
                        "Value #A": "Free CPU",
                        "Value #B": "Free memory",
                        "Value #C": "Free volume"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.1.1",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": true,
                    "displayName": "Free CPU"
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "decimals": 2,
                  "custom": {
                    "align": "left",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": true,
                    "inspect": false,
                    "footer": {
                      "reducers": [
                        "sum"
                      ]
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Free CPU"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "cpu"
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gradient-gauge"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Free memory"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "bytes"
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gradient-gauge"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Free volume"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "bytes"
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "gradient-gauge"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Tightest nodes by free CPU",
          "description": "The $max_shown nodes with least free CPU, over time. A node trending towards zero is about to stop accepting work.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "bottomk($max_shown,\n  (\n  sum by (cluster, node) (kube_node_status_allocatable{resource=\"cpu\", cluster=~\"$cluster\"})\n  -\n  (\n    sum by (cluster, node) (kube_pod_container_resource_requests{resource=\"cpu\", node!=\"\", cluster=~\"$cluster\"})\n    or\n    sum by (cluster, node) (kube_node_status_allocatable{resource=\"cpu\", cluster=~\"$cluster\"}) * 0\n  )\n)\n  and on (cluster, node) (\n  (\n    group by (cluster, node) (kube_node_spec_unschedulable{cluster=~\"$cluster\"} == 0)\n    unless group by (cluster, node) (kube_node_role{role=\"control-plane\", cluster=~\"$cluster\"})\n  )\n  ${pool} (\n    (\n    group by (cluster, node) (kube_node_spec_unschedulable{cluster=~\"$cluster\"} == 0)\n    unless group by (cluster, node) (kube_node_role{role=\"control-plane\", cluster=~\"$cluster\"})\n  )\n    and group by (cluster, node) (\n      kube_node_labels{label_node_role_wiremind_io_production=\"true\", cluster=~\"$cluster\"}\n      or kube_node_labels{label_node_role_kubernetes_io_production=\"true\", cluster=~\"$cluster\"}\n    )\n  )\n)\n)\n",
                        "instant": false,
                        "legendFormat": "{{cluster}} / {{node}}",
                        "range": true
                      },
                      "labels": {
                        "grafana.app/export-label": "prometheus-1",
                        "grafana.app/export-datasource-name": "${datasource}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 800,
                "interval": "5m"
              }
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.1.1",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "min",
                    "lastNotNull"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true,
                  "sortBy": "Mean",
                  "sortDesc": true
                },
                "tooltip": {
                  "hideZeros": true,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "cpu",
                  "color": {
                    "mode": "palette-classic"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "decimals": 1,
                  "min": 0,
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisPlacement": "auto",
                    "axisSoftMin": 0,
                    "barAlignment": 0,
                    "barWidthFactor": 0.6,
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "gradientMode": "none",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "linear",
                    "lineWidth": 1,
                    "pointSize": 5,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "showValues": false,
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
