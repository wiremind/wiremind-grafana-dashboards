      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Cluster Node Utilisation by CPU and RAM requests",
          "description": "This table shows the comparison of CPU and RAM requests by applications, vs the capacity of the node",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "max by (node) (kube_node_labels{cluster=~\"$cluster.*\", $node_selector})\n* on (node)\n(\n  min by (node) (\n    sum by (node, instance) (\n      kube_pod_status_phase{cluster=~\"$cluster.*\", phase=~\"Running\"}\n      * on (uid, instance) group_right\n      kube_pod_container_resource_requests{cluster=~\"$cluster.*\", resource=\"cpu\"}\n    )\n  )\n  /\n  min by (node) (sum by (node, instance) (kube_node_status_allocatable{cluster=~\"$cluster.*\", resource=\"cpu\"}))\n) * 100",
                        "format": "table",
                        "instant": true,
                        "interval": "",
                        "intervalFactor": 1,
                        "legendFormat": "{{ node }}"
                      },
                      "labels": {
                        "grafana.app/export-label": "prometheus-1",
                        "grafana.app/export-datasource-name": "Thanos"
