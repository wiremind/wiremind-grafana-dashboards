                      "spec": {
                        "editorMode": "code",
                        "exemplar": true,
                        "expr": "sum by(deployment)(kube_deployment_status_replicas{namespace=\"$namespace\", deployment=~\"($namespace-.*-normal)|($namespace-internal)|($namespace-workers-.*)|($namespace-skypallet-.*)\", deployment!=\"$namespace-scheduler-normal\"})",
                        "instant": false,
                        "interval": "",
                        "legendFormat": "__auto"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by(queue)(label_replace(\n  kube_deployment_status_replicas{namespace=\"$namespace\"},\n  \"queue\",           \n  \"$1\",\n  \"deployment\",\n  \"$namespace-(.*)\"\n) and on(queue)\nlabel_replace(\n  rabbitmq_queue_messages{namespace=\"$namespace\"},\n  \"queue\",           \n  \"$1-$2\",\n  \"queue\",\n  \"(.*)\\\\.(.*)\"\n))\nor\nsum by(queue)(label_replace(\n  kube_deployment_status_replicas{namespace=\"$namespace\"},\n  \"queue\",\n  \"$1\",\n  \"deployment\",\n  \"(?:$namespace|paxone)-(.*?)(?:-normal)?\"\n) and on(queue)\nlabel_replace(\n  pgmq_queue_length{namespace=\"$namespace\"},\n  \"queue\",\n  \"$1\",\n  \"queue_name\",\n  \"(.*)\"\n))",
                        "instant": false,
                        "legendFormat": "{{queue}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "renameByRegex",
                  "spec": {
                    "options": {
                      "regex": "cayzn-\\w*-\\w*-(.*)-normal",
                      "renamePattern": "$1"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "renameByRegex",
                  "spec": {
                    "options": {
                      "regex": "cayzn-\\w*-\\w*-internal",
                      "renamePattern": "internal"
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
