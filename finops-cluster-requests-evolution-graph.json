      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Memory requests by namespace",
          "description": "Per-namespace requests, unstacked; limited to the $topk largest series.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "topk($topk,\n  sum by (cluster, namespace, label_product, label_project) (\n    kube_namespace_labels{label_product=~\"$product\", label_project=~\"$project\", label_environment_kind=~\"$kind\", cluster=~\"$cluster\", namespace=~\"$namespace\"}\n    * on (cluster, namespace) group_right(label_environment_kind, label_project, label_product, label_client)\n    ${agg}_over_time(namespace_memory:kube_pod_container_resource_requests:sum{cluster=~\"$cluster\", namespace=~\"$namespace\"}[$__interval])\n  )\n)\n",
                        "instant": false,
                        "legendFormat": "{{cluster}} / {{namespace}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {
                "maxDataPoints": 800,
                "interval": "5m"
              }
